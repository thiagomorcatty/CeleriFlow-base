  placa    String
  tipo     String // Estacionamento irregular, Velocidade, etc.
  local    String
  valor    Float?
  status   String   @default("Registrado") // Registrado, Notificado, Em Recurso, Pago, Cancelado
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SegurancaMobilidadeRegistro {
  id            String    @id @default(cuid())
  codigo        String    @unique
  categoria     String // Ronda, Videomonitoramento, Defesa Civil, Sinalizacao, Mobilidade Urbana, Transporte, Interdicao, Estacionamento, Acessibilidade, Ordem de Servico, Equipamento, Documento, Relatorio
  tipo          String
  titulo        String
  descricao     String?
  local         String?
  bairro        String?
  responsavel   String?
  prioridade    String    @default("Normal") // Baixa, Normal, Alta, Urgente
  status        String    @default("Ativo")
  dataInicio    DateTime  @default(now())
  dataFim       DateTime?
  valor         Float?
  placa         String?
  relatedModule String?
  relatedId     String?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------

model ConfiguracaoInstancia {
  id             String  @id @default(cuid())
  nomePrefeitura String
  cnpj           String?
  municipio      String
  uf             String
  dominio        String?
  status         String  @default("Ativa") // Ativa, Suspensa, Manutenção

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoModulo {
  id           String    @id @default(cuid())
  nome         String
  codigo       String    @unique
  ativo        Boolean   @default(false)
  dataAtivacao DateTime?

  usuariosModulo UsuarioModulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoPerfil {
  id         String  @id @default(cuid())
  nome       String // Administrador Municipal, Gestor, Operador
  descricao  String?
  permissoes String // JSON string with permissions
  ativo      Boolean @default(true)

  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id    String  @id @default(cuid())
  nome  String
  email String  @unique
  senha String // Hash da senha (Firebase uid ou local)
  ativo Boolean @default(true)

  perfilId String
  perfil   ConfiguracaoPerfil @relation(fields: [perfilId], references: [id])

  permissoesModulo UsuarioModulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsuarioModulo {
  id        String @id @default(cuid())
  usuarioId String
  moduloId  String

  usuario Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo  ConfiguracaoModulo @relation(fields: [moduloId], references: [id])

  canView Boolean @default(false)
  canEdit Boolean @default(false)

  @@unique([usuarioId, moduloId])
}
