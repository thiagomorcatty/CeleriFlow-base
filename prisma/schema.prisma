  editionNumber Int       @unique
  publishDate   DateTime
  pdfUrl        String
  status        String    @default("Rascunho") // Publicado, Rascunho
  authorId      String?
  author        Employee? @relation("DiaryAuthor", fields: [authorId], references: [id])
