// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  role           String?
  organization   String
  city           String
  state          String
  email          String
  phone          String?
  moduleInterest String?
  message        String?
  consent        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Módulo 1: Administração Geral ---

// Cadastro único da Prefeitura/Entidade Principal
model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?
  legalName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  mayorName   String?
  managerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Secretarias, Autarquias e Fundos
model Secretariat {
  id          String               @id @default(cuid())
  name        String
  acronym     String?
  managerName String?
  departments Department[]
  units       AdministrativeUnit[]
  employees   Employee[]
  demands     InternalDemand[]

  // Mod 6
  portalNews  PortalNews[] @relation("NewsSecretariat")

  // Mod 8
  budgetUnits BudgetUnit[] @relation("SecretariatBudgetUnits")
  revenues    Revenue[]    @relation("SecretariatRevenues")
  expenses    Expense[]    @relation("SecretariatExpenses")

  // Mod 9
  purchaseRequests  PurchaseRequest[] @relation("SecretariatPurchaseRequests")
  purchaseProcesses PurchaseProcess[] @relation("SecretariatPurchaseProcesses")
  contracts         Contract[]        @relation("SecretariatContracts")

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// Departamentos / Setores
model Department {
  id            String           @id @default(cuid())
  name          String
  description   String?
  secretariatId String
  secretariat   Secretariat      @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  demands       InternalDemand[]

  // Mod 3
  currentProcesses Process[]         @relation("CurrentDepartment")
  movementsFrom    ProcessMovement[] @relation("MovementFrom")
  movementsTo      ProcessMovement[] @relation("MovementTo")
  dispatches       ProcessDispatch[] @relation("DispatchDepartment")

  // Mod 4 e 5
  folders    Folder[]    @relation("FolderDepartment")
  tickets    Ticket[]    @relation("TicketDepartment")
  ombudsmans Ombudsman[] @relation("OmbudsmanDepartment")

  // Mod 9
  purchaseRequests PurchaseRequest[] @relation("DepartmentPurchaseRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Unidades Administrativas (Escolas, UBS, CRAS, Almoxarifados)
model AdministrativeUnit {
  id            String      @id @default(cuid())
  name          String
  type          String // e.g., 'Escola', 'UBS', 'CRAS', 'Almoxarifado'
  address       String?
  managerName   String?
  secretariatId String
  secretariat   Secretariat @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Cargos e Funções
model Role {
  id          String     @id @default(cuid())
  name        String
  description String?
  level       String? // 'Diretor', 'Coordenador', 'Servidor', etc.
  canSign     Boolean    @default(false)
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Servidores Básicos (Base para RH e vinculação de responsáveis)
model Employee {
  id           String  @id @default(cuid())
  name         String
  cpf          String? @unique
  registration String? // Matrícula
  email        String?
  phone        String?
  isActive     Boolean @default(true)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  unitId String?
  unit   AdministrativeUnit? @relation(fields: [unitId], references: [id])

  demands        InternalDemand[] @relation("DemandAssignee")
  createdDemands InternalDemand[] @relation("DemandCreator")

  // Mod 3
  processMovements  ProcessMovement[] @relation("MovementEmployee")
  processDocuments  ProcessDocument[] @relation("DocumentEmployee")
  processDispatches ProcessDispatch[] @relation("DispatchEmployee")

  // Mod 4 e 5
  tickets            Ticket[]            @relation("TicketAssignee")
  ticketInteractions TicketInteraction[] @relation("InteractionEmployee")

  // Mod 6
  portalPages        PortalPage[]        @relation("PageAuthor")
  portalNews         PortalNews[]        @relation("NewsAuthor")
  officialDiaries    OfficialDiary[]     @relation("DiaryAuthor")

  // Mod 8
  settlements        Settlement[]        @relation("SettlementAuthor")
  accountingEntries  AccountingEntry[]   @relation("AccountingEntryAuthor")

  // Mod 9
  purchaseRequests    PurchaseRequest[] @relation("EmployeePurchaseRequests")
  managedContracts    Contract[]        @relation("ContractManager")
  inspectedContracts  Contract[]        @relation("ContractInspector")

  // Mod 10
  personId           String?            @unique
  person             Person?            @relation("PersonEmployee", fields: [personId], references: [id])
  payrolls           PayrollItem[]      @relation("EmployeePayrollItem")
  vacations          Vacation[]         @relation("EmployeeVacation")
  leaves             Leave[]            @relation("EmployeeLeave")
  attendances        AttendanceRecord[] @relation("EmployeeAttendance")
  dependents         Dependent[]        @relation("EmployeeDependent")
  benefits           PayrollBenefit[]   @relation("EmployeeBenefit")
  personnelActs      PersonnelAct[]     @relation("EmployeePersonnelAct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Demandas Administrativas Internas
model InternalDemand {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("Aberta") // Aberta, Em andamento, Concluída, etc.
  priority    String    @default("Normal") // Baixa, Normal, Alta, Urgente
  deadline    DateTime?

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("DemandAssignee", fields: [assigneeId], references: [id])

  creatorId String?
  creator   Employee? @relation("DemandCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Calendário Institucional
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  isHoliday   Boolean  @default(false)
  type        String // 'Feriado Nacional', 'Ponto Facultativo', 'Expediente Especial'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Módulo 2: Cadastros Gerais ---

// Pessoas Físicas
model Person {
  id             String    @id @default(cuid())
  fullName       String
  socialName     String?
  cpf            String    @unique
  rg             String?
  rgIssuer       String?
  birthDate      DateTime?
  gender         String?
  nationality    String?
  birthPlace     String?
  maritalStatus  String?
  profession     String?
  educationLevel String?
  motherName     String?
  fatherName     String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phonePrimary   String?
  phoneSecondary String?
  whatsapp       String?
  email          String?
  emailSecondary String?

  // Relacionamentos
  addresses            Address[]
  taxpayerInfo         Taxpayer?
  supplierInfo         Supplier?
  legalRepresentations LegalRepresentative[] @relation("RepresentedPerson")
  representedBy        LegalRepresentative[] @relation("RepresentativePerson")
  documents            Document[]

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets    Ticket[]
  ombudsmans Ombudsman[]

  // Mod 10
  dependents Dependent[] @relation("PersonDependent")
  employee   Employee?   @relation("PersonEmployee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pessoas Jurídicas
model Company {
  id             String    @id @default(cuid())
  corporateName  String
  tradeName      String?
  cnpj           String    @unique
  municipalInsc  String?
  stateInsc      String?
  companyType    String? // MEI, ME, EPP, LTDA, SA, etc.
  legalNature    String?
  primaryCnae    String?
  secondaryCnaes String?
  openingDate    DateTime?
  taxRegime      String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phone         String?
  whatsapp      String?
  emailPrimary  String?
  emailFiscal   String?
  website       String?
  contactPerson String?

  // Relacionamentos
  addresses       Address[]
  taxpayerInfo    Taxpayer?
  supplierInfo    Supplier?
  representatives LegalRepresentative[] @relation("RepresentedCompany")
  documents       Document[]

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contribuintes
model Taxpayer {
  id                 String  @id @default(cuid())
  taxpayerType       String // PF ou PJ
  municipalInsc      String? @unique
  status             String  @default("Ativo")
  economicActivities String?
  fiscalNotes        String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  realEstates           RealEstate[]
  economicRegistrations EconomicRegistration[]
  taxAssessments        TaxAssessment[]
  licenses              License[]
  debtInstallments      DebtInstallment[]
  activeDebts           ActiveDebt[]
  taxCertificates       TaxCertificate[]
  infractions           Infraction[]
  providedInvoices      Invoice[]              @relation("InvoiceProvider")
  takenInvoices         Invoice[]              @relation("InvoiceTaker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fornecedores
model Supplier {
  id                       String    @id @default(cuid())
  category                 String?
  businessBranch           String?
  bankData                 String?
  certificationsValidUntil DateTime?
  status                   String    @default("Ativo") // Ativo, Suspenso, Inativo
  notes                    String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mod 8
  commitments Commitment[] @relation("SupplierCommitments")
  payments    Payment[]    @relation("SupplierPayments")

  // Mod 9
  priceQuotes       PriceQuote[]        @relation("SupplierPriceQuotes")
  contracts         Contract[]          @relation("SupplierContracts")
  directContracting DirectContracting[] @relation("SupplierDirectContracting")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Representantes Legais
model LegalRepresentative {
  id                 String    @id @default(cuid())
  representationType String // Procurador, Sócio, Contador, Pai, Mãe
  startDate          DateTime?
  endDate            DateTime?
  grantedPowers      String?
  status             String    @default("Ativo")
  notes              String?

  // Quem está sendo representado
  representedPersonId String?
  representedPerson   Person? @relation("RepresentedPerson", fields: [representedPersonId], references: [id])

  representedCompanyId String?
  representedCompany   Company? @relation("RepresentedCompany", fields: [representedCompanyId], references: [id])

  // Quem é o representante (sempre uma pessoa física na maioria dos casos)
  representativeId String
  representative   Person @relation("RepresentativePerson", fields: [representativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Endereços
model Address {
  id             String  @id @default(cuid())
  zipCode        String?
  streetName     String?
  number         String?
  complement     String?
  referencePoint String?
  addressType    String? // Residencial, Comercial, Correspondência
  zone           String? // Urbana, Rural
  latitude       Float?
  longitude      Float?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bairros / Localidades
model Neighborhood {
  id          String  @id @default(cuid())
  name        String
  type        String // Bairro, Distrito, Povoado
  city        String
  state       String
  adminRegion String?
  notes       String?

  addresses   Address[]
  streets     Street[]
  realEstates RealEstate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Logradouros
model Street {
  id      String  @id @default(cuid())
  name    String
  type    String // Rua, Avenida, Praça
  zipCode String?
  city    String
  state   String
  status  String  @default("Ativo")

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Imóveis
model RealEstate {
  id            String  @id @default(cuid())
  municipalInsc String? @unique
  registration  String? // Matrícula
  propertyType  String? // Casa, Terreno, Apartamento, Galpão
  status        String  @default("Regular")

  // Endereço do imóvel (pode ser diferente do endereço do contribuinte)
  streetName String?
  number     String?
  complement String?
  lot        String?
  block      String?

  landArea    Float?
  builtArea   Float?
  propertyUse String? // Residencial, Comercial, Misto
  fiscalZone  String?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  taxpayerId String?
  taxpayer   Taxpayer? @relation(fields: [taxpayerId], references: [id])

  taxAssessments TaxAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos e Anexos
model Document {
  id           String    @id @default(cuid())
  title        String
  documentType String // RG, CPF, CNPJ, Contrato, Comprovante
  fileUrl      String
  validUntil   DateTime?
  status       String    @default("Válido") // Válido, Vencido, Pendente
  notes        String?

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation("DocumentFolder", fields: [folderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 3: Protocolos e Processos ---

// Tipo de Processo
model ProcessType {
  id          String  @id @default(cuid())
  name        String // Alvará, Licença, Certidão, Ofício...
  description String?
  isActive    Boolean @default(true)

  subjects  Subject[]
  processes Process[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Assunto do Processo (vinculado a um Tipo)
model Subject {
  id            String      @id @default(cuid())
  name          String
  description   String?
  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  slaDays       Int? // Prazo padrão em dias para conclusão
  isActive      Boolean     @default(true)

  processes Process[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Processo / Protocolo Principal
model Process {
  id             String  @id @default(cuid())
  protocolNumber String  @unique // ex: 2026/00001
  status         String  @default("Aberto") // Aberto, Em Análise, Concluído, Arquivado
  description    String?
  priority       String  @default("Normal") // Normal, Alta, Urgente

  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  // Interessado (Cidadão ou Empresa)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Setor atual onde o processo está
  currentDepartmentId String?
  currentDepartment   Department? @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id])

  movements  ProcessMovement[]
  documents  ProcessDocument[]
  dispatches ProcessDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tramitação entre setores
model ProcessMovement {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  fromDepartmentId String?
  fromDepartment   Department? @relation("MovementFrom", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("MovementTo", fields: [toDepartmentId], references: [id])

  employeeId String?
  employee   Employee? @relation("MovementEmployee", fields: [employeeId], references: [id]) // Quem encaminhou

  reason  String?
  movedAt DateTime @default(now())
}

// Documentos/Anexos do Processo
model ProcessDocument {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  title        String
  fileUrl      String
  documentType String?

  employeeId String?
  employee   Employee? @relation("DocumentEmployee", fields: [employeeId], references: [id]) // Quem anexou

  createdAt DateTime @default(now())
}

// Despachos e Pareceres
model ProcessDispatch {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  content      String
  dispatchType String @default("Despacho") // Despacho, Parecer, Decisão

  employeeId String
  employee   Employee @relation("DispatchEmployee", fields: [employeeId], references: [id]) // Quem despachou

  departmentId String?
  department   Department? @relation("DispatchDepartment", fields: [departmentId], references: [id]) // Setor no momento do despacho

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 4: GED (Gerenciamento Eletrônico de Documentos) ---

model Folder {
  id          String  @id @default(cuid())
  name        String
  description String?

  parentId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")

  departmentId String?
  department   Department? @relation("FolderDepartment", fields: [departmentId], references: [id])

  documents Document[] @relation("DocumentFolder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 5: Atendimento e Ouvidoria ---

model SupportChannel {
  id          String  @id @default(cuid())
  name        String // e.g., 'Portal', 'Presencial', 'WhatsApp', 'Telefone'
  description String?
  isActive    Boolean @default(true)

  tickets    Ticket[]
  ombudsmans Ombudsman[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String @id @default(cuid())
  ticketNumber String @unique // e.g., TKT-2026-0001
  subject      String
  description  String
  status       String @default("Aberto") // Aberto, Em Atendimento, Resolvido, Fechado
  priority     String @default("Normal")

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  departmentId String?
  department   Department? @relation("TicketDepartment", fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  interactions TicketInteraction[]
  satisfaction SatisfactionSurvey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ombudsman {
  id             String  @id @default(cuid())
  protocolNumber String  @unique
  type           String // Denúncia, Reclamação, Elogio, Sugestão
  subject        String
  description    String
  isAnonymous    Boolean @default(false)
  isConfidential Boolean @default(false)
  status         String  @default("Recebida")

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  departmentId String?
  department   Department? @relation("OmbudsmanDepartment", fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketInteraction {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message    String
  isInternal Boolean @default(false)

  employeeId String?
  employee   Employee? @relation("InteractionEmployee", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
}

model SatisfactionSurvey {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int // 1 to 5
  comments String?

  createdAt DateTime @default(now())
}

// --- Módulo 6: Portal e Transparência ---

model PortalPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  status    String   @default("Rascunho") // Publicado, Rascunho, Inativo
  authorId  String?
  author    Employee? @relation("PageAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortalMenu {
  id        String   @id @default(cuid())
  name      String
  url       String?
  parentId  String?
  parent    PortalMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  PortalMenu[] @relation("MenuHierarchy")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortalNews {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  slug          String   @unique
  content       String
  imageUrl      String?
  status        String   @default("Rascunho")
  publishedAt   DateTime?
  authorId      String?
  author        Employee? @relation("NewsAuthor", fields: [authorId], references: [id])
  secretariatId String?
  secretariat   Secretariat? @relation("NewsSecretariat", fields: [secretariatId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PortalBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  String   @default("Principal")
  order     Int      @default(0)
  status    String   @default("Ativo")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficialPublication {
  id          String   @id @default(cuid())
  title       String
  category    String // Edital, Comunicado, Resultado, etc
  description String?
  fileUrl     String?
  linkUrl     String?
  status      String   @default("Publicado")
  publishDate DateTime @default(now())
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfficialDiary {
  id             String   @id @default(cuid())
  editionNumber  Int      @unique
  publishDate    DateTime
  pdfUrl         String
  status         String   @default("Rascunho") // Publicado, Rascunho
  authorId       String?
  author         Employee? @relation("DiaryAuthor", fields: [authorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PublicService {
  id          String   @id @default(cuid())
  name        String
  description String
  target      String // Cidadão, Empresa, Servidor
  requirements String?
  steps       String?
  deadline    String?
  cost        String?
  linkUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InformationRequest {
  id             String   @id @default(cuid())
  protocolNumber String   @unique
  subject        String
  description    String
  status         String   @default("Recebido") // Em análise, Respondido, Prorrogado
  answer         String?
  requesterName  String
  requesterEmail String
  requesterDoc   String // CPF ou CNPJ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Módulo 7: Tributação ---

// Cadastro Econômico (Inscrição Municipal de Empresas e Autônomos)
model EconomicRegistration {
  id            String    @id @default(cuid())
  municipalInsc String    @unique
  primaryCnae   String?
  taxRegime     String? // Simples Nacional, Lucro Presumido, etc.
  status        String    @default("Ativo")
  startDate     DateTime?

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  taxAssessments TaxAssessment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  licenses  License[]
}

// Tabela de Parametrização de Tributos (Ex: IPTU, ISS, Taxa de Alvará)
model Tax {
  id       String  @id @default(cuid())
  name     String // IPTU, ITBI, ISS, Taxa de Coleta de Lixo
  taxType  String // Imposto, Taxa, Contribuição
  isActive Boolean @default(true)

  assessments TaxAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lançamento Tributário (Dívida gerada para um contribuinte/imóvel/empresa)
model TaxAssessment {
  id            String @id @default(cuid())
  year          Int // Exercício (Ex: 2026)
  originalValue Float
  status        String @default("Lançado") // Lançado, Emitido, Pago, Dívida Ativa, Cancelado

  taxId String
  tax   Tax    @relation(fields: [taxId], references: [id])

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  // Pode estar vinculado a um Imóvel (IPTU) ou a um Cadastro Econômico (ISS/Taxas)
  realEstateId String?
  realEstate   RealEstate? @relation(fields: [realEstateId], references: [id])

  economicRegistrationId String?
  economicRegistration   EconomicRegistration? @relation(fields: [economicRegistrationId], references: [id])

  guides TaxGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guia de Arrecadação (Boleto/DAM emitido)
model TaxGuide {
  id         String   @id @default(cuid())
  barcode    String?  @unique
  totalValue Float
  dueDate    DateTime
  status     String   @default("Emitida") // Emitida, Paga, Vencida, Cancelada

  assessmentId String
  assessment   TaxAssessment @relation(fields: [assessmentId], references: [id])

  payments TaxPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pagamento / Baixa
model TaxPayment {
  id            String   @id @default(cuid())
  amountPaid    Float
  paymentDate   DateTime
  clearanceDate DateTime @default(now()) // Data da baixa no sistema
  paymentMethod String // PIX, Boleto, Manual

  guideId String
  guide   TaxGuide @relation(fields: [guideId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Alvarás e Licenças
model License {
  id          String    @id @default(cuid())
  licenseType String // Alvará de Funcionamento, Licença Sanitária, etc.
  status      String    @default("Solicitado") // Solicitado, Emitido, Vencido, Suspenso
  issueDate   DateTime?
  validUntil  DateTime?
  qrCode      String?

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  economicRegistrationId String?
  economicRegistration   EconomicRegistration? @relation(fields: [economicRegistrationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Parcelamentos de Débitos
model DebtInstallment {
  id                String @id @default(cuid())
  totalValue        Float
  downPayment       Float? // Entrada
  installmentsCount Int
  status            String @default("Ativo") // Ativo, Pago, Rescindido

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dívida Ativa e CDA
model ActiveDebt {
  id             String  @id @default(cuid())
  originDebtType String // Ex: IPTU, ISS
  year           Int
  originalValue  Float
  updatedValue   Float
  cdaNumber      String? @unique
  status         String  @default("Inscrita") // Inscrita, Em Cobrança, Parcelada, Protestada, Ajuizada, Paga

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Certidões Tributárias
model TaxCertificate {
  id              String   @id @default(cuid())
  certificateType String // CND, Positiva com efeito de Negativa, Valor Venal
  authCode        String   @unique
  validUntil      DateTime
  status          String   @default("Emitida") // Emitida, Revogada

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Autos de Infração e Fiscalização
model Infraction {
  id              String    @id @default(cuid())
  infractionType  String // Omissão de ISS, Falta de Alvará
  penaltyValue    Float
  defenseDeadline DateTime?
  status          String    @default("Emitido") // Emitido, Cientificado, Em Defesa, Pago, Inscrito em Dívida Ativa

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Nota Fiscal de Serviço Eletrônica (NFS-e)
model Invoice {
  id               String  @id @default(cuid())
  invoiceNumber    Int     @default(autoincrement())
  verificationCode String  @unique
  serviceValue     Float
  deductions       Float   @default(0)
  issRetained      Boolean @default(false)
  issValue         Float
  competence       String // Ex: "07/2026"
  status           String  @default("Emitida") // Emitida, Cancelada, Substituída

  providerId String
  provider   Taxpayer @relation("InvoiceProvider", fields: [providerId], references: [id])

  takerId String?
  taker   Taxpayer? @relation("InvoiceTaker", fields: [takerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 8: Financeiro e Contábil ---

model FinancialYear {
  id        String   @id @default(cuid())
  year      Int      @unique
  status    String   @default("Aberto") // Aberto, Encerrado
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetAppropriations BudgetAppropriation[]
}

model BudgetUnit {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  secretariatId String
  secretariat   Secretariat  @relation("SecretariatBudgetUnits", fields: [secretariatId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  appropriations BudgetAppropriation[]
}

model ResourceSource {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appropriations BudgetAppropriation[]
  bankAccounts   BankAccount[]
  revenues       Revenue[]
}

model RevenueNature {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revenues Revenue[]
}

model ExpenseNature {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appropriations BudgetAppropriation[]
}

model BudgetAppropriation {
  id              String         @id @default(cuid())
  code            String         @unique
  financialYearId String
  financialYear   FinancialYear  @relation(fields: [financialYearId], references: [id])
  budgetUnitId    String
  budgetUnit      BudgetUnit     @relation(fields: [budgetUnitId], references: [id])
  expenseNatureId String
  expenseNature   ExpenseNature  @relation(fields: [expenseNatureId], references: [id])
  resourceSourceId String
  resourceSource  ResourceSource @relation(fields: [resourceSourceId], references: [id])
  initialValue    Float          @default(0)
  updatedValue    Float          @default(0)
  committedValue  Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reservations BudgetReservation[]
  commitments  Commitment[]
  expenses     Expense[]
}

model Revenue {
  id              String         @id @default(cuid())
  date            DateTime       @default(now())
  value           Float
  revenueNatureId String
  revenueNature   RevenueNature  @relation(fields: [revenueNatureId], references: [id])
  resourceSourceId String
  resourceSource  ResourceSource @relation(fields: [resourceSourceId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?   @relation(fields: [bankAccountId], references: [id])
  secretariatId   String?
  secretariat     Secretariat?   @relation("SecretariatRevenues", fields: [secretariatId], references: [id])
  status          String         @default("Arrecadada")
  history         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Expense {
  id              String               @id @default(cuid())
  date            DateTime             @default(now())
  description     String
  value           Float
  appropriationId String
  appropriation   BudgetAppropriation  @relation(fields: [appropriationId], references: [id])
  secretariatId   String
  secretariat     Secretariat          @relation("SecretariatExpenses", fields: [secretariatId], references: [id])
  status          String               @default("Solicitada") // Solicitada, Reservada, Empenhada
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model BudgetReservation {
  id              String               @id @default(cuid())
  number          String               @unique
  date            DateTime             @default(now())
  value           Float
  appropriationId String
  appropriation   BudgetAppropriation  @relation(fields: [appropriationId], references: [id])
  justification   String?
  status          String               @default("Ativa") // Ativa, Cancelada, Empenhada
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Commitment {
  id              String               @id @default(cuid())
  number          String               @unique
  date            DateTime             @default(now())
  value           Float
  type            String               @default("Ordinário") // Ordinário, Estimativo, Global
  history         String
  appropriationId String
  appropriation   BudgetAppropriation  @relation(fields: [appropriationId], references: [id])
  supplierId      String
  supplier        Supplier             @relation("SupplierCommitments", fields: [supplierId], references: [id])
  status          String               @default("Emitido") // Emitido, Liquidado, Pago, Anulado
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  settlements     Settlement[]
  payments        Payment[]
}

model Settlement {
  id           String      @id @default(cuid())
  date         DateTime    @default(now())
  value        Float
  documentRef  String?     // NF, Recibo, etc
  commitmentId String
  commitment   Commitment  @relation(fields: [commitmentId], references: [id])
  authorId     String
  author       Employee    @relation("SettlementAuthor", fields: [authorId], references: [id])
  status       String      @default("Liquidado") // Liquidado, Cancelado
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  payments     Payment[]
}

model Payment {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  date          DateTime    @default(now())
  value         Float
  commitmentId  String
  commitment    Commitment  @relation(fields: [commitmentId], references: [id])
  settlementId  String?
  settlement    Settlement? @relation(fields: [settlementId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  supplierId    String
  supplier      Supplier    @relation("SupplierPayments", fields: [supplierId], references: [id])
  paymentMethod String      @default("Transferência")
  status        String      @default("Pago") // Pago, Cancelado
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BankAccount {
  id               String          @id @default(cuid())
  bankName         String
  agency           String
  accountNumber    String
  accountType      String          @default("Movimento")
  currentBalance   Float           @default(0)
  resourceSourceId String?
  resourceSource   ResourceSource? @relation(fields: [resourceSourceId], references: [id])
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  revenues         Revenue[]
  payments         Payment[]
  reconciliations  BankReconciliation[]
}

model BankReconciliation {
  id            String      @id @default(cuid())
  date          DateTime    @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  systemBalance Float
  bankBalance   Float
  status        String      @default("Pendente") // Pendente, Conciliado, Divergente
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AccountingPlan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   // Receita, Despesa, Ativo, Passivo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   AccountingEntry[]
}

model AccountingEntry {
  id            String         @id @default(cuid())
  date          DateTime       @default(now())
  value         Float
  type          String         // Débito, Crédito
  history       String
  accountId     String
  account       AccountingPlan @relation(fields: [accountId], references: [id])
  authorId      String
  author        Employee       @relation("AccountingEntryAuthor", fields: [authorId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// --- Módulo 9: Compras e Contratos ---

model CatalogItem {
  id             String   @id @default(cuid())
  code           String?  @unique
  name           String
  description    String?
  unit           String   @default("UN")
  category       String?
  estimatedValue Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PurchaseRequest {
  id             String   @id @default(cuid())
  number         String   @unique
  object         String
  justification  String
  estimatedValue Float?
  status         String   @default("Rascunho") // Rascunho, Enviada, Aprovada, Rejeitada, etc.
  priority       String   @default("Normal")
  
  secretariatId  String
  secretariat    Secretariat @relation("SecretariatPurchaseRequests", fields: [secretariatId], references: [id])
  
  departmentId   String
  department     Department  @relation("DepartmentPurchaseRequests", fields: [departmentId], references: [id])
  
  requesterId    String
  requester      Employee    @relation("EmployeePurchaseRequests", fields: [requesterId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PurchaseProcess {
  id             String   @id @default(cuid())
  number         String   @unique
  object         String
  type           String   // Comum, Registro de Preços
  modality       String?  // Pregão, Concorrência, Dispensa, Inexigibilidade
  estimatedValue Float?
  status         String   @default("Em Planejamento")
  
  secretariatId  String
  secretariat    Secretariat @relation("SecretariatPurchaseProcesses", fields: [secretariatId], references: [id])
  
  preliminaryStudies PreliminaryTechnicalStudy[]
  termsOfReference   TermOfReference[]
  priceResearches    PriceResearch[]
  biddings           Bidding[]
  directContractings DirectContracting[]
  contracts          Contract[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PreliminaryTechnicalStudy {
  id               String   @id @default(cuid())
  description      String
  justification    String
  estimatedValue   Float?
  status           String   @default("Em Elaboração") // Em Elaboração, Aprovado
  
  processId        String
  process          PurchaseProcess @relation(fields: [processId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TermOfReference {
  id               String   @id @default(cuid())
  object           String
  justification    String
  scope            String
  estimatedValue   Float?
  status           String   @default("Em Elaboração") // Em Elaboração, Aprovado
  
  processId        String
  process          PurchaseProcess @relation(fields: [processId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PriceResearch {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  estimatedValue Float?
  status         String   @default("Em Andamento") // Em Andamento, Concluída
  
  processId      String
  process        PurchaseProcess @relation(fields: [processId], references: [id])
  
  quotes         PriceQuote[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PriceQuote {
  id             String   @id @default(cuid())
  value          Float
  date           DateTime @default(now())
  status         String   @default("Ativa")
  
  researchId     String
  research       PriceResearch @relation(fields: [researchId], references: [id])
  
  supplierId     String
  supplier       Supplier @relation("SupplierPriceQuotes", fields: [supplierId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bidding {
  id              String   @id @default(cuid())
  number          String
  modality        String
  status          String   @default("Em Elaboração")
  publicationDate DateTime?
  sessionDate     DateTime?
  
  processId       String
  process         PurchaseProcess @relation(fields: [processId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DirectContracting {
  id             String   @id @default(cuid())
  type           String   // Dispensa, Inexigibilidade
  justification  String
  value          Float
  status         String   @default("Em Elaboração")
  
  processId      String
  process        PurchaseProcess @relation(fields: [processId], references: [id])
  
  supplierId     String
  supplier       Supplier @relation("SupplierDirectContracting", fields: [supplierId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Contract {
  id             String   @id @default(cuid())
  number         String   @unique
  object         String
  initialValue   Float
  updatedValue   Float
  startDate      DateTime
  endDate        DateTime
  status         String   @default("Minuta") // Minuta, Vigente, Encerrado, etc.
  
  processId      String
  process        PurchaseProcess @relation(fields: [processId], references: [id])
  
  supplierId     String
  supplier       Supplier @relation("SupplierContracts", fields: [supplierId], references: [id])
  
  secretariatId  String
  secretariat    Secretariat @relation("SecretariatContracts", fields: [secretariatId], references: [id])
  
  managerId      String?
  manager        Employee? @relation("ContractManager", fields: [managerId], references: [id])
  
  inspectorId    String?
  inspector      Employee? @relation("ContractInspector", fields: [inspectorId], references: [id])
  
  amendments     ContractAmendment[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContractAmendment {
  id               String   @id @default(cuid())
  type             String   // Prazo, Valor, Ambos
  justification    String
  previousValue    Float?
  newValue         Float?
  previousEndDate  DateTime?
  newEndDate       DateTime?
  status           String   @default("Minuta")
  
  contractId       String
  contract         Contract @relation(fields: [contractId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


// --- Módulo 10: RH e Folha ---

model Payroll {
  id          String   @id @default(cuid())
  competence  String   // "07/2026"
  type        String   @default("Mensal") // Mensal, Férias, 13º, Rescisão
  status      String   @default("Aberta") // Aberta, Fechada, Paga
  totalValue  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PayrollItem[]
}

model PayrollEvent {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   // Vencimento, Desconto, Base
  formula     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PayrollItem[]
}

model PayrollItem {
  id          String       @id @default(cuid())
  payrollId   String
  payroll     Payroll      @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee     @relation("EmployeePayrollItem", fields: [employeeId], references: [id])
  eventId     String
  event       PayrollEvent @relation(fields: [eventId], references: [id])
  value       Float
  reference   String?      // "10", "220h"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Vacation {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation("EmployeeVacation", fields: [employeeId], references: [id])
  acquisitionStart DateTime
  acquisitionEnd   DateTime
  enjoymentStart   DateTime?
  enjoymentEnd     DateTime?
  days            Int       @default(30)
  status          String    @default("A vencer") // A vencer, Disponível, Programada, Em gozo, Concluída
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Leave {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("EmployeeLeave", fields: [employeeId], references: [id])
  type        String    // Licença médica, Maternidade, Sem vencimento
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String    @default("Ativa")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("EmployeeAttendance", fields: [employeeId], references: [id])
  date        DateTime
  entryTime   DateTime?
  exitTime    DateTime?
  status      String    @default("Presente") // Presente, Falta, Atraso, Férias, Licença
  hoursWorked Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Dependent {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation("EmployeeDependent", fields: [employeeId], references: [id])
  personId       String?
  person         Person?   @relation("PersonDependent", fields: [personId], references: [id])
  name           String
  cpf            String?
  birthDate      DateTime?
  relationship   String    // Filho, Cônjuge
  irrfDependent  Boolean   @default(false)
  familyWage     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PayrollBenefit {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("EmployeeBenefit", fields: [employeeId], references: [id])
  type        String    // Vale Transporte, Vale Alimentação
  value       Float
  status      String    @default("Ativo")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PersonnelAct {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("EmployeePersonnelAct", fields: [employeeId], references: [id])
  type        String    // Nomeação, Exoneração, Férias
  actNumber   String?
  date        DateTime  @default(now())
  documentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
