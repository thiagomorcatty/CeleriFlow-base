// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  role           String?
  organization   String
  city           String
  state          String
  email          String
  phone          String?
  moduleInterest String?
  message        String?
  consent        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Módulo 1: Administração Geral ---

// Cadastro único da Prefeitura/Entidade Principal
model Institution {
  id          String   @id @default(cuid())
  name        String
  cnpj        String?
  legalName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  mayorName   String?
  managerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Secretarias, Autarquias e Fundos
model Secretariat {
  id          String               @id @default(cuid())
  name        String
  acronym     String?
  managerName String?
  departments Department[]
  units       AdministrativeUnit[]
  employees   Employee[]
  demands     InternalDemand[]

  // Mod 6
  portalNews PortalNews[] @relation("NewsSecretariat")

  // Mod 8
  budgetUnits BudgetUnit[] @relation("SecretariatBudgetUnits")
  revenues    Revenue[]    @relation("SecretariatRevenues")
  expenses    Expense[]    @relation("SecretariatExpenses")

  // Mod 9
  purchaseRequests  PurchaseRequest[] @relation("SecretariatPurchaseRequests")
  purchaseProcesses PurchaseProcess[] @relation("SecretariatPurchaseProcesses")
  contracts         Contract[]        @relation("SecretariatContracts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Departamentos / Setores
model Department {
  id            String           @id @default(cuid())
  name          String
  description   String?
  secretariatId String
  secretariat   Secretariat      @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  demands       InternalDemand[]

  // Mod 3
  currentProcesses Process[]         @relation("CurrentDepartment")
  movementsFrom    ProcessMovement[] @relation("MovementFrom")
  movementsTo      ProcessMovement[] @relation("MovementTo")
  dispatches       ProcessDispatch[] @relation("DispatchDepartment")

  // Mod 4 e 5
  folders    Folder[]    @relation("FolderDepartment")
  tickets    Ticket[]    @relation("TicketDepartment")
  ombudsmans Ombudsman[] @relation("OmbudsmanDepartment")

  // Mod 9
  purchaseRequests PurchaseRequest[] @relation("DepartmentPurchaseRequests")

  // Mod 11
  assets           Asset[]
  transfersFrom    AssetTransfer[]    @relation("TransferFromDept")
  transfersTo      AssetTransfer[]    @relation("TransferToDept")
  materialMoves    MaterialMovement[] @relation("MovementDepartment")
  materialRequests MaterialRequest[]  @relation("MaterialRequestDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

// Unidades Administrativas (Escolas, UBS, CRAS, Almoxarifados)
model AdministrativeUnit {
  id            String      @id @default(cuid())
  name          String
  type          String // e.g., 'Escola', 'UBS', 'CRAS', 'Almoxarifado'
  address       String?
  managerName   String?
  secretariatId String
  secretariat   Secretariat @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  employees     Employee[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Cargos e Funções
model Role {
  id          String     @id @default(cuid())
  name        String
  description String?
  level       String? // 'Diretor', 'Coordenador', 'Servidor', etc.
  canSign     Boolean    @default(false)
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Servidores Básicos (Base para RH e vinculação de responsáveis)
model Employee {
  id              String  @id @default(cuid())
  name            String
  cpf             String? @unique
  registration    String? // Matrícula
  email           String?
  phone           String?
  isActive        Boolean @default(true)
  salaryBase      Float   @default(0)
  contractedHours Int     @default(220)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  unitId String?
  unit   AdministrativeUnit? @relation(fields: [unitId], references: [id])

  demands        InternalDemand[] @relation("DemandAssignee")
  createdDemands InternalDemand[] @relation("DemandCreator")

  // Mod 3
  processMovements  ProcessMovement[] @relation("MovementEmployee")
  processDocuments  ProcessDocument[] @relation("DocumentEmployee")
  processDispatches ProcessDispatch[] @relation("DispatchEmployee")

  // Mod 4 e 5
  tickets            Ticket[]            @relation("TicketAssignee")
  ticketInteractions TicketInteraction[] @relation("InteractionEmployee")

  // Mod 6
  portalPages     PortalPage[]    @relation("PageAuthor")
  portalNews      PortalNews[]    @relation("NewsAuthor")
  officialDiaries OfficialDiary[] @relation("DiaryAuthor")

  // Mod 8
  settlements       Settlement[]      @relation("SettlementAuthor")
  accountingEntries AccountingEntry[] @relation("AccountingEntryAuthor")

  // Mod 9
  purchaseRequests   PurchaseRequest[] @relation("EmployeePurchaseRequests")
  managedContracts   Contract[]        @relation("ContractManager")
  inspectedContracts Contract[]        @relation("ContractInspector")

  // Mod 10
  personId      String?            @unique
  person        Person?            @relation("PersonEmployee", fields: [personId], references: [id])
  payrolls      PayrollItem[]      @relation("EmployeePayrollItem")
  vacations     Vacation[]         @relation("EmployeeVacation")
  leaves        Leave[]            @relation("EmployeeLeave")
  attendances   AttendanceRecord[] @relation("EmployeeAttendance")
  dependents    Dependent[]        @relation("EmployeeDependent")
  benefits      PayrollBenefit[]   @relation("EmployeeBenefit")
  personnelActs PersonnelAct[]     @relation("EmployeePersonnelAct")

  // Mod 11
  managedWarehouses  Warehouse[]       @relation("WarehouseManager")
  responsibleAssets  Asset[]           @relation("AssetResponsible")
  assetTransfersFrom AssetTransfer[]   @relation("TransferFromResp")
  assetTransfersTo   AssetTransfer[]   @relation("TransferToResp")
  materialRequests   MaterialRequest[] @relation("MaterialRequester")

  // Mod 12
  directedSchools School[] @relation("SchoolDirector")
  teacher         Teacher? @relation("EmployeeTeacher")

  // Mod 13
  healthProfessional HealthProfessional? @relation("EmployeeHealthProfessional")
  managedHealthUnits HealthUnit[]        @relation("HealthUnitManager")

  // Mod 14
  managedSocialUnits SocialUnit[]              @relation("SocialUnitManager")
  socialAttendances  SocialAttendance[]        @relation("SocialAttendanceProfessional")
  socialVisits       SocialVisit[]             @relation("SocialVisitProfessional")
  socialConcessions  SocialBenefitConcession[] @relation("SocialConcessionProfessional")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Demandas Administrativas Internas
model InternalDemand {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("Aberta") // Aberta, Em andamento, Concluída, etc.
  priority    String    @default("Normal") // Baixa, Normal, Alta, Urgente
  deadline    DateTime?

  secretariatId String?
  secretariat   Secretariat? @relation(fields: [secretariatId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("DemandAssignee", fields: [assigneeId], references: [id])

  creatorId String?
  creator   Employee? @relation("DemandCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Calendário Institucional
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  isHoliday   Boolean  @default(false)
  type        String // 'Feriado Nacional', 'Ponto Facultativo', 'Expediente Especial'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Módulo 2: Cadastros Gerais ---

// Pessoas Físicas
model Person {
  id             String    @id @default(cuid())
  fullName       String
  socialName     String?
  cpf            String    @unique
  rg             String?
  rgIssuer       String?
  birthDate      DateTime?
  gender         String?
  nationality    String?
  birthPlace     String?
  maritalStatus  String?
  profession     String?
  educationLevel String?
  motherName     String?
  fatherName     String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phonePrimary   String?
  phoneSecondary String?
  whatsapp       String?
  email          String?
  emailSecondary String?

  // Relacionamentos
  addresses            Address[]
  taxpayerInfo         Taxpayer?
  supplierInfo         Supplier?
  legalRepresentations LegalRepresentative[] @relation("RepresentedPerson")
  representedBy        LegalRepresentative[] @relation("RepresentativePerson")
  documents            Document[]

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets    Ticket[]
  ombudsmans Ombudsman[]

  // Mod 10
  dependents Dependent[] @relation("PersonDependent")
  employee   Employee?   @relation("PersonEmployee")

  // Mod 12
  studentInfo Student?              @relation("StudentPerson")
  guardianFor EducationalGuardian[] @relation("GuardianPerson")

  // Mod 13
  patientInfo Patient? @relation("PersonPatient")

  // Mod 14
  socialFamily       SocialFamily?             @relation("FamilyRepresentative")
  socialFamilyMember SocialFamilyMember?       @relation("FamilyMemberPerson")
  socialAttendances  SocialAttendance[]
  socialConcessions  SocialBenefitConcession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pessoas Jurídicas
model Company {
  id             String    @id @default(cuid())
  corporateName  String
  tradeName      String?
  cnpj           String    @unique
  municipalInsc  String?
  stateInsc      String?
  companyType    String? // MEI, ME, EPP, LTDA, SA, etc.
  legalNature    String?
  primaryCnae    String?
  secondaryCnaes String?
  openingDate    DateTime?
  taxRegime      String?
  status         String    @default("Ativo") // Ativo, Inativo

  // Contatos
  phone         String?
  whatsapp      String?
  emailPrimary  String?
  emailFiscal   String?
  website       String?
  contactPerson String?

  // Relacionamentos
  addresses       Address[]
  taxpayerInfo    Taxpayer?
  supplierInfo    Supplier?
  representatives LegalRepresentative[] @relation("RepresentedCompany")
  documents       Document[]

  // Mod 3
  processes Process[]

  // Mod 4 e 5
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contribuintes
model Taxpayer {
  id                 String  @id @default(cuid())
  taxpayerType       String // PF ou PJ
  municipalInsc      String? @unique
  status             String  @default("Ativo")
  economicActivities String?
  fiscalNotes        String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  realEstates           RealEstate[]
  economicRegistrations EconomicRegistration[]
  taxAssessments        TaxAssessment[]
  licenses              License[]
  debtInstallments      DebtInstallment[]
  activeDebts           ActiveDebt[]
  taxCertificates       TaxCertificate[]
  infractions           Infraction[]
  providedInvoices      Invoice[]              @relation("InvoiceProvider")
  takenInvoices         Invoice[]              @relation("InvoiceTaker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fornecedores
model Supplier {
  id                       String    @id @default(cuid())
  category                 String?
  businessBranch           String?
  bankData                 String?
  certificationsValidUntil DateTime?
  status                   String    @default("Ativo") // Ativo, Suspenso, Inativo
  notes                    String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mod 8
  commitments Commitment[] @relation("SupplierCommitments")
  payments    Payment[]    @relation("SupplierPayments")

  // Mod 9
  priceQuotes       PriceQuote[]        @relation("SupplierPriceQuotes")
  contracts         Contract[]          @relation("SupplierContracts")
  directContracting DirectContracting[] @relation("SupplierDirectContracting")

  // Mod 11
  assets            Asset[]            @relation("AssetSupplier")
  assetMaintenances AssetMaintenance[] @relation("AssetMaintenanceSupplier")
  materialMovements MaterialMovement[] @relation("MaterialMovementSupplier")

  // Mod 10
  benefitConfigs BenefitConfig[] @relation("SupplierBenefitConfig")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Representantes Legais
model LegalRepresentative {
  id                 String    @id @default(cuid())
  representationType String // Procurador, Sócio, Contador, Pai, Mãe
  startDate          DateTime?
  endDate            DateTime?
  grantedPowers      String?
  status             String    @default("Ativo")
  notes              String?

  // Quem está sendo representado
  representedPersonId String?
  representedPerson   Person? @relation("RepresentedPerson", fields: [representedPersonId], references: [id])

  representedCompanyId String?
  representedCompany   Company? @relation("RepresentedCompany", fields: [representedCompanyId], references: [id])

  // Quem é o representante (sempre uma pessoa física na maioria dos casos)
  representativeId String
  representative   Person @relation("RepresentativePerson", fields: [representativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Endereços
model Address {
  id             String  @id @default(cuid())
  zipCode        String?
  streetName     String?
  number         String?
  complement     String?
  referencePoint String?
  addressType    String? // Residencial, Comercial, Correspondência
  zone           String? // Urbana, Rural
  latitude       Float?
  longitude      Float?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Mod 12
  school School? @relation("SchoolAddress")

  // Mod 13
  healthUnit HealthUnit? @relation("HealthUnitAddress")

  // Mod 14
  socialUnit     SocialUnit?    @relation("SocialUnitAddress")
  socialFamilies SocialFamily[] @relation("FamilyAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bairros / Localidades
model Neighborhood {
  id          String  @id @default(cuid())
  name        String
  type        String // Bairro, Distrito, Povoado
  city        String
  state       String
  adminRegion String?
  notes       String?

  addresses   Address[]
  streets     Street[]
  realEstates RealEstate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Logradouros
model Street {
  id      String  @id @default(cuid())
  name    String
  type    String // Rua, Avenida, Praça
  zipCode String?
  city    String
  state   String
  status  String  @default("Ativo")

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Imóveis
model RealEstate {
  id            String  @id @default(cuid())
  municipalInsc String? @unique
  registration  String? // Matrícula
  propertyType  String? // Casa, Terreno, Apartamento, Galpão
  status        String  @default("Regular")

  // Endereço do imóvel (pode ser diferente do endereço do contribuinte)
  streetName String?
  number     String?
  complement String?
  lot        String?
  block      String?

  landArea    Float?
  builtArea   Float?
  propertyUse String? // Residencial, Comercial, Misto
  fiscalZone  String?

  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  taxpayerId String?
  taxpayer   Taxpayer? @relation(fields: [taxpayerId], references: [id])

  taxAssessments TaxAssessment[]

  assets      Asset[]
  schools     School[]
  socialUnits SocialUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos e Anexos
model Document {
  id           String    @id @default(cuid())
  title        String
  documentType String // RG, CPF, CNPJ, Contrato, Comprovante
  fileUrl      String
  validUntil   DateTime?
  status       String    @default("Válido") // Válido, Vencido, Pendente
  notes        String?

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation("DocumentFolder", fields: [folderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 3: Protocolos e Processos ---

// Tipo de Processo
model ProcessType {
  id          String  @id @default(cuid())
  name        String // Alvará, Licença, Certidão, Ofício...
  description String?
  isActive    Boolean @default(true)

  subjects  Subject[]
  processes Process[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Assunto do Processo (vinculado a um Tipo)
model Subject {
  id            String      @id @default(cuid())
  name          String
  description   String?
  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  slaDays       Int? // Prazo padrão em dias para conclusão
  isActive      Boolean     @default(true)

  processes Process[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Processo / Protocolo Principal
model Process {
  id             String  @id @default(cuid())
  protocolNumber String  @unique // ex: 2026/00001
  status         String  @default("Aberto") // Aberto, Em Análise, Concluído, Arquivado
  description    String?
  priority       String  @default("Normal") // Normal, Alta, Urgente

  processTypeId String
  processType   ProcessType @relation(fields: [processTypeId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  // Interessado (Cidadão ou Empresa)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Setor atual onde o processo está
  currentDepartmentId String?
  currentDepartment   Department? @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id])

  movements  ProcessMovement[]
  documents  ProcessDocument[]
  dispatches ProcessDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tramitação entre setores
model ProcessMovement {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  fromDepartmentId String?
  fromDepartment   Department? @relation("MovementFrom", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("MovementTo", fields: [toDepartmentId], references: [id])

  employeeId String?
  employee   Employee? @relation("MovementEmployee", fields: [employeeId], references: [id]) // Quem encaminhou

  reason  String?
  movedAt DateTime @default(now())
}

// Documentos/Anexos do Processo
model ProcessDocument {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  title        String
  fileUrl      String
  documentType String?

  employeeId String?
  employee   Employee? @relation("DocumentEmployee", fields: [employeeId], references: [id]) // Quem anexou

  createdAt DateTime @default(now())
}

// Despachos e Pareceres
model ProcessDispatch {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  content      String
  dispatchType String @default("Despacho") // Despacho, Parecer, Decisão

  employeeId String
  employee   Employee @relation("DispatchEmployee", fields: [employeeId], references: [id]) // Quem despachou

  departmentId String?
  department   Department? @relation("DispatchDepartment", fields: [departmentId], references: [id]) // Setor no momento do despacho

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 4: GED (Gerenciamento Eletrônico de Documentos) ---

model Folder {
  id          String  @id @default(cuid())
  name        String
  description String?

  parentId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")

  departmentId String?
  department   Department? @relation("FolderDepartment", fields: [departmentId], references: [id])

  documents Document[] @relation("DocumentFolder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 5: Atendimento e Ouvidoria ---

model SupportChannel {
  id          String  @id @default(cuid())
  name        String // e.g., 'Portal', 'Presencial', 'WhatsApp', 'Telefone'
  description String?
  isActive    Boolean @default(true)

  tickets    Ticket[]
  ombudsmans Ombudsman[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String @id @default(cuid())
  ticketNumber String @unique // e.g., TKT-2026-0001
  subject      String
  description  String
  status       String @default("Aberto") // Aberto, Em Atendimento, Resolvido, Fechado
  priority     String @default("Normal")

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  departmentId String?
  department   Department? @relation("TicketDepartment", fields: [departmentId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  interactions TicketInteraction[]
  satisfaction SatisfactionSurvey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ombudsman {
  id             String  @id @default(cuid())
  protocolNumber String  @unique
  type           String // Denúncia, Reclamação, Elogio, Sugestão
  subject        String
  description    String
  isAnonymous    Boolean @default(false)
  isConfidential Boolean @default(false)
  status         String  @default("Recebida")

  channelId String
  channel   SupportChannel @relation(fields: [channelId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  departmentId String?
  department   Department? @relation("OmbudsmanDepartment", fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketInteraction {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message    String
  isInternal Boolean @default(false)

  employeeId String?
  employee   Employee? @relation("InteractionEmployee", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
}

model SatisfactionSurvey {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int // 1 to 5
  comments String?

  createdAt DateTime @default(now())
}

// --- Módulo 6: Portal e Transparência ---

model PortalPage {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  content   String
  status    String    @default("Rascunho") // Publicado, Rascunho, Inativo
  authorId  String?
  author    Employee? @relation("PageAuthor", fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PortalMenu {
  id        String       @id @default(cuid())
  name      String
  url       String?
  parentId  String?
  parent    PortalMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  PortalMenu[] @relation("MenuHierarchy")
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PortalNews {
  id            String       @id @default(cuid())
  title         String
  subtitle      String?
  slug          String       @unique
  content       String
  imageUrl      String?
  status        String       @default("Rascunho")
  publishedAt   DateTime?
  authorId      String?
