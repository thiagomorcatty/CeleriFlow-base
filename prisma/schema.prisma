// --- Módulo 7: Tributação ---

// Cadastro Econômico (Inscrição Municipal de Empresas e Autônomos)
model EconomicRegistration {
  id            String    @id @default(cuid())
  municipalInsc String    @unique
  primaryCnae   String?
  taxRegime     String? // Simples Nacional, Lucro Presumido, etc.
  status        String    @default("Ativo")
  startDate     DateTime?

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  taxAssessments TaxAssessment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  licenses  License[]
}

// Tabela de Parametrização de Tributos (Ex: IPTU, ISS, Taxa de Alvará)
model Tax {
  id       String  @id @default(cuid())
  name     String // IPTU, ITBI, ISS, Taxa de Coleta de Lixo
  taxType  String // Imposto, Taxa, Contribuição
  isActive Boolean @default(true)

  assessments TaxAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lançamento Tributário (Dívida gerada para um contribuinte/imóvel/empresa)
model TaxAssessment {
  id            String @id @default(cuid())
  year          Int // Exercício (Ex: 2026)
  originalValue Float
  status        String @default("Lançado") // Lançado, Emitido, Pago, Dívida Ativa, Cancelado

  taxId String
  tax   Tax    @relation(fields: [taxId], references: [id])

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  // Pode estar vinculado a um Imóvel (IPTU) ou a um Cadastro Econômico (ISS/Taxas)
  realEstateId String?
  realEstate   RealEstate? @relation(fields: [realEstateId], references: [id])

  economicRegistrationId String?
  economicRegistration   EconomicRegistration? @relation(fields: [economicRegistrationId], references: [id])

  guides TaxGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guia de Arrecadação (Boleto/DAM emitido)
model TaxGuide {
  id         String   @id @default(cuid())
  barcode    String?  @unique
  totalValue Float
  dueDate    DateTime
  status     String   @default("Emitida") // Emitida, Paga, Vencida, Cancelada

  assessmentId String
  assessment   TaxAssessment @relation(fields: [assessmentId], references: [id])

  payments TaxPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pagamento / Baixa
model TaxPayment {
  id            String   @id @default(cuid())
  amountPaid    Float
  paymentDate   DateTime
  clearanceDate DateTime @default(now()) // Data da baixa no sistema
  paymentMethod String // PIX, Boleto, Manual

  guideId String
  guide   TaxGuide @relation(fields: [guideId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Alvarás e Licenças
model License {
  id          String    @id @default(cuid())
  licenseType String // Alvará de Funcionamento, Licença Sanitária, etc.
  status      String    @default("Solicitado") // Solicitado, Emitido, Vencido, Suspenso
  issueDate   DateTime?
  validUntil  DateTime?
  qrCode      String?

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  economicRegistrationId String?
  economicRegistration   EconomicRegistration? @relation(fields: [economicRegistrationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Parcelamentos de Débitos
model DebtInstallment {
  id                String @id @default(cuid())
  totalValue        Float
  downPayment       Float? // Entrada
  installmentsCount Int
  status            String @default("Ativo") // Ativo, Pago, Rescindido

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dívida Ativa e CDA
model ActiveDebt {
  id             String  @id @default(cuid())
  originDebtType String // Ex: IPTU, ISS
  year           Int
  originalValue  Float
  updatedValue   Float
  cdaNumber      String? @unique
  status         String  @default("Inscrita") // Inscrita, Em Cobrança, Parcelada, Protestada, Ajuizada, Paga

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Certidões Tributárias
model TaxCertificate {
  id              String   @id @default(cuid())
  certificateType String // CND, Positiva com efeito de Negativa, Valor Venal
  authCode        String   @unique
  validUntil      DateTime
  status          String   @default("Emitida") // Emitida, Revogada

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Autos de Infração e Fiscalização
model Infraction {
  id              String    @id @default(cuid())
  infractionType  String // Omissão de ISS, Falta de Alvará
  penaltyValue    Float
  defenseDeadline DateTime?
  status          String    @default("Emitido") // Emitido, Cientificado, Em Defesa, Pago, Inscrito em Dívida Ativa

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Nota Fiscal de Serviço Eletrônica (NFS-e)
model Invoice {
  id               String  @id @default(cuid())
  invoiceNumber    Int     @default(autoincrement())
  verificationCode String  @unique
  serviceValue     Float
  deductions       Float   @default(0)
  issRetained      Boolean @default(false)
  issValue         Float
  competence       String // Ex: "07/2026"
  status           String  @default("Emitida") // Emitida, Cancelada, Substituída

  providerId String
  provider   Taxpayer @relation("InvoiceProvider", fields: [providerId], references: [id])

  takerId String?
  taker   Taxpayer? @relation("InvoiceTaker", fields: [takerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Módulo 8: Financeiro e Contábil ---

model FinancialYear {
  id        String   @id @default(cuid())
  year      Int      @unique
  status    String   @default("Aberto") // Aberto, Encerrado
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetAppropriations BudgetAppropriation[]
}

model BudgetUnit {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  secretariatId String
  secretariat   Secretariat @relation("SecretariatBudgetUnits", fields: [secretariatId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appropriations BudgetAppropriation[]
}

model ResourceSource {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appropriations BudgetAppropriation[]
  bankAccounts   BankAccount[]
  revenues       Revenue[]
}

model RevenueNature {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revenues Revenue[]
}

model ExpenseNature {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appropriations BudgetAppropriation[]
}

model BudgetAppropriation {
  id               String         @id @default(cuid())
  code             String         @unique
  financialYearId  String
  financialYear    FinancialYear  @relation(fields: [financialYearId], references: [id])
  budgetUnitId     String
  budgetUnit       BudgetUnit     @relation(fields: [budgetUnitId], references: [id])
  expenseNatureId  String
  expenseNature    ExpenseNature  @relation(fields: [expenseNatureId], references: [id])
  resourceSourceId String
  resourceSource   ResourceSource @relation(fields: [resourceSourceId], references: [id])
  initialValue     Float          @default(0)
  updatedValue     Float          @default(0)
  committedValue   Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reservations BudgetReservation[]
  commitments  Commitment[]
  expenses     Expense[]
}

model Revenue {
  id               String         @id @default(cuid())
  date             DateTime       @default(now())
  value            Float
  revenueNatureId  String
  revenueNature    RevenueNature  @relation(fields: [revenueNatureId], references: [id])
  resourceSourceId String
  resourceSource   ResourceSource @relation(fields: [resourceSourceId], references: [id])
  bankAccountId    String?
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id])
  secretariatId    String?
  secretariat      Secretariat?   @relation("SecretariatRevenues", fields: [secretariatId], references: [id])
  status           String         @default("Arrecadada")
  history          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Expense {
  id              String              @id @default(cuid())
  date            DateTime            @default(now())
  description     String
  value           Float
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  secretariatId   String
  secretariat     Secretariat         @relation("SecretariatExpenses", fields: [secretariatId], references: [id])
  status          String              @default("Solicitada") // Solicitada, Reservada, Empenhada

  socialProgramId String?
  socialProgram   SocialProgram? @relation(fields: [socialProgramId], references: [id])

  socialBenefitId String?
  socialBenefit   SocialBenefit? @relation(fields: [socialBenefitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetReservation {
  id              String              @id @default(cuid())
  number          String              @unique
  date            DateTime            @default(now())
  value           Float
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  justification   String?
  status          String              @default("Ativa") // Ativa, Cancelada, Empenhada
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Commitment {
  id              String              @id @default(cuid())
  number          String              @unique
  date            DateTime            @default(now())
  value           Float
  type            String              @default("Ordinário") // Ordinário, Estimativo, Global
  history         String
  appropriationId String
  appropriation   BudgetAppropriation @relation(fields: [appropriationId], references: [id])
  supplierId      String
  supplier        Supplier            @relation("SupplierCommitments", fields: [supplierId], references: [id])
  status          String              @default("Emitido") // Emitido, Liquidado, Pago, Anulado
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  settlements Settlement[]
  payments    Payment[]
}

model Settlement {
  id           String     @id @default(cuid())
  date         DateTime   @default(now())
  value        Float
  documentRef  String? // NF, Recibo, etc
  commitmentId String
  commitment   Commitment @relation(fields: [commitmentId], references: [id])
  authorId     String
  author       Employee   @relation("SettlementAuthor", fields: [authorId], references: [id])
  status       String     @default("Liquidado") // Liquidado, Cancelado
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payments Payment[]
}

model Payment {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  date          DateTime    @default(now())
  value         Float
  commitmentId  String
  commitment    Commitment  @relation(fields: [commitmentId], references: [id])
  settlementId  String?
  settlement    Settlement? @relation(fields: [settlementId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  supplierId    String
  supplier      Supplier    @relation("SupplierPayments", fields: [supplierId], references: [id])
  paymentMethod String      @default("Transferência")
  status        String      @default("Pago") // Pago, Cancelado
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BankAccount {
  id               String          @id @default(cuid())
  bankName         String
  agency           String
  accountNumber    String
  accountType      String          @default("Movimento")
  currentBalance   Float           @default(0)
  resourceSourceId String?
  resourceSource   ResourceSource? @relation(fields: [resourceSourceId], references: [id])
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  revenues        Revenue[]
  payments        Payment[]
  reconciliations BankReconciliation[]
}

model BankReconciliation {
  id            String      @id @default(cuid())
  date          DateTime    @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  systemBalance Float
  bankBalance   Float
  status        String      @default("Pendente") // Pendente, Conciliado, Divergente
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AccountingPlan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String // Receita, Despesa, Ativo, Passivo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AccountingEntry[]
}

model AccountingEntry {
  id        String         @id @default(cuid())
  date      DateTime       @default(now())
  value     Float
  type      String // Débito, Crédito
  history   String
  accountId String
  account   AccountingPlan @relation(fields: [accountId], references: [id])
  authorId  String
  author    Employee       @relation("AccountingEntryAuthor", fields: [authorId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// --- Módulo 9: Compras e Contratos ---

model CatalogItem {
  id             String  @id @default(cuid())
  code           String? @unique
  name           String
  description    String?
  unit           String  @default("UN")
  category       String?
  estimatedValue Float?
  isActive       Boolean @default(true)

  // Mod 11
  materials Material[]

  purchaseRequestItems PurchaseRequestItem[]
  purchaseProcessItems PurchaseProcessItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequest {
  id             String @id @default(cuid())
  number         String @unique
  object         String
  justification  String
  estimatedValue Float?
  status         String @default("Rascunho") // Rascunho, Enviada, Aprovada, Rejeitada, etc.
  priority       String @default("Normal")

  secretariatId String
  secretariat   Secretariat @relation("SecretariatPurchaseRequests", fields: [secretariatId], references: [id])

  departmentId String
  department   Department @relation("DepartmentPurchaseRequests", fields: [departmentId], references: [id])

  requesterId String
  requester   Employee @relation("EmployeePurchaseRequests", fields: [requesterId], references: [id])

  items PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequestItem {
  id                 String          @id @default(cuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  catalogItemId      String?
  catalogItem        CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  customName         String?
  quantity           Float
  estimatedUnitValue Float?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseProcess {
  id             String  @id @default(cuid())
  number         String  @unique
  object         String
  type           String // Comum, Registro de Preços
  modality       String? // Pregão, Concorrência, Dispensa, Inexigibilidade
  estimatedValue Float?
  status         String  @default("Em Planejamento")

  secretariatId String
  secretariat   Secretariat @relation("SecretariatPurchaseProcesses", fields: [secretariatId], references: [id])

  preliminaryStudies PreliminaryTechnicalStudy[]
  termsOfReference   TermOfReference[]
  priceResearches    PriceResearch[]
  biddings           Bidding[]
  directContractings DirectContracting[]
  contracts          Contract[]

  items PurchaseProcessItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseProcessItem {
  id                 String          @id @default(cuid())
  purchaseProcessId  String
  purchaseProcess    PurchaseProcess @relation(fields: [purchaseProcessId], references: [id], onDelete: Cascade)
  catalogItemId      String?
  catalogItem        CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  customName         String?
  quantity           Float
  estimatedUnitValue Float?

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PreliminaryTechnicalStudy {
  id             String @id @default(cuid())
  description    String
  justification  String
  estimatedValue Float?
  status         String @default("Em Elaboração") // Em Elaboração, Aprovado

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermOfReference {
  id             String @id @default(cuid())
  object         String
  justification  String
  scope          String
  estimatedValue Float?
  status         String @default("Em Elaboração") // Em Elaboração, Aprovado

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceResearch {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  estimatedValue Float?
  status         String   @default("Em Andamento") // Em Andamento, Concluída

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  quotes PriceQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceQuote {
  id     String   @id @default(cuid())
  value  Float
  date   DateTime @default(now())
  status String   @default("Ativa")

  researchId String
  research   PriceResearch @relation(fields: [researchId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierPriceQuotes", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bidding {
  id              String    @id @default(cuid())
  number          String
  modality        String
  status          String    @default("Em Elaboração")
  publicationDate DateTime?
  sessionDate     DateTime?

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DirectContracting {
  id            String @id @default(cuid())
  type          String // Dispensa, Inexigibilidade
  justification String
  value         Float
  status        String @default("Em Elaboração")

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierDirectContracting", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id           String   @id @default(cuid())
  number       String   @unique
  object       String
  initialValue Float
  updatedValue Float
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Minuta") // Minuta, Vigente, Encerrado, etc.

  processId String
  process   PurchaseProcess @relation(fields: [processId], references: [id])

  supplierId String
  supplier   Supplier @relation("SupplierContracts", fields: [supplierId], references: [id])

  secretariatId String
  secretariat   Secretariat @relation("SecretariatContracts", fields: [secretariatId], references: [id])

  managerId String?
  manager   Employee? @relation("ContractManager", fields: [managerId], references: [id])

  inspectorId String?
  inspector   Employee? @relation("ContractInspector", fields: [inspectorId], references: [id])

  amendments ContractAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractAmendment {
  id              String    @id @default(cuid())
  type            String // Prazo, Valor, Ambos
  justification   String
  previousValue   Float?
  newValue        Float?
  previousEndDate DateTime?
  newEndDate      DateTime?
  status          String    @default("Minuta")

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

